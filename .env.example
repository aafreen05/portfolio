# ===========================================================================
#  Environment template — committed to git, so it holds NO real values.
#
#  Local:  copy to .env.local and fill in.
#  Vercel: add the same keys under Project -> Settings -> Environment Variables.
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase — Project Settings -> API in the Supabase dashboard.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable "anon" key. Safe to expose — Row Level Security is what protects
# the data, and the policies in supabase/schema.sql assume this key is public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret "service_role" key. SERVER ONLY — it bypasses Row Level Security.
# Never prefix it with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical tags, Open Graph
# images, JSON-LD and the sitemap.
# Local:      http://localhost:3000
# Production: https://aafreenbegam.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Admin account — used only by `npm run admin:setup` (local, one-off).
# Creates or updates the Supabase Auth user and adds it to the admin
# allowlist. Not needed on Vercel.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Contact notifications — https://resend.com/api-keys
# Every contact-form message is saved to Supabase (the admin inbox) AND
# emailed here. Without RESEND_API_KEY messages are still saved.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Inbox that receives the notifications. With the default sender below this
# must be the email address that owns the Resend account.
CONTACT_NOTIFY_EMAIL=
# Optional sender. Unset = Resend's shared test sender, which can only deliver
# to the email address that owns the Resend account. After verifying your
# domain in Resend, use e.g.: Portfolio <hello@aafreenbegam.in>
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Supabase keep-alive cron — any long random string.
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to
# /api/cron/keep-alive; requests without it are rejected.
# Generate one with:  node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------
CRON_SECRET=
